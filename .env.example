# Copy to .env on the VPS and replace every placeholder before starting Docker.

DB_NAME=springshop
DB_USERNAME=springshop_user
DB_PASSWORD=your_db_password_here
DB_SSL_MODE=disable

# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_TIME=900000

REDIS_URL=redis://redis:6379

CORS_ALLOWED_ORIGINS=https://api.example.com,https://www.example.com
RATE_LIMIT_USE_FORWARDED_HEADERS=true

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=https://www.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://www.example.com/checkout/cancel

APP_PUBLIC_PORT=3000
HOST_BIND_ADDRESS=127.0.0.1
APP_SEED_ENABLED=false
JPA_DDL_AUTO=updatenano
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
